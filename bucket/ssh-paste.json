{
    "version": "0.1.12",
    "description": "Paste screenshots into programs that run over SSH",
    "homepage": "https://github.com/xuing/ssh-please-paste-picture",
    "license": "MIT",
    "notes": "Turn it on for a host: ssh-paste --enable HOST",
    "url": [
        "https://github.com/xuing/ssh-please-paste-picture/releases/download/v0.1.12/ssh-paste.ps1",
        "https://github.com/xuing/ssh-please-paste-picture/releases/download/v0.1.12/ssh-paste.cmd"
    ],
    "hash": [
        "e8b0013a37fda65165d20024d12789790d821fdee3a3dd76d8f61782f5ae51f8",
        "78dfbfc93c162f93373ff77e14ebaa1cc6fcf2c0fccfd94d2ab49bbd5774b9c1"
    ],
    "bin": "ssh-paste.cmd",
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "    $config = Join-Path $env:USERPROFILE '.ssh\\config'",
            "    $paths = @((Join-Path (Split-Path -Parent $dir) 'current\\ssh-paste.ps1'), (Join-Path $dir 'ssh-paste.ps1'))",
            "    if ((Test-Path -LiteralPath $config) -and @(Select-String -LiteralPath $config -SimpleMatch -Pattern $paths -ErrorAction Stop).Count -gt 0) {",
            "        & \"$dir\\ssh-paste.cmd\" --disable",
            "        if ($LASTEXITCODE -ne 0) { throw 'ssh-paste --disable failed, so ssh-paste stays installed: fix ~/.ssh/config, then run scoop uninstall ssh-paste again' }",
            "    }",
            "}"
        ]
    },
    "checkver": {
        "github": "https://github.com/xuing/ssh-please-paste-picture"
    },
    "autoupdate": {
        "url": [
            "https://github.com/xuing/ssh-please-paste-picture/releases/download/v$version/ssh-paste.ps1",
            "https://github.com/xuing/ssh-please-paste-picture/releases/download/v$version/ssh-paste.cmd"
        ],
        "hash": {
            "url": "$baseurl/SHA256SUMS",
            "regex": "$sha256\\s+$basename"
        }
    }
}
